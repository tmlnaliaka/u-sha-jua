PROJECT_NAME="u-SHA-jua Disaster Informatics Platform"
DATABASE_URL=sqlite:///./ushajua.db
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# Security & Role-Based Access Control (RBAC) Keys
ENFORCE_STRICT_AUTH=false
DISPATCHER_API_KEY=replace-with-dispatcher-api-key
RESPONDER_API_KEY=replace-with-responder-api-key
ADMIN_API_KEY=replace-with-admin-api-key
SMS_WEBHOOK_SECRET=replace-with-telecom-webhook-secret

# Optional External Services (Falls back to offline Kenya Gazetteer when blank)
GEMINI_API_KEY=
MAPBOX_ACCESS_TOKEN=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=uSHAjua

